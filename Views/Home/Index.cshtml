@model IReadOnlyList<UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
    
    List<Guid> selectedIds = new();
}


@section Scripts{
    <script>
        const selectAll =
            document.getElementById("selectAll");

        const checkboxes =
            document.querySelectorAll(".user-checkbox");

        const blockButton =
            document.getElementById("blockButton");

        const unblockButton =
            document.getElementById("unblockButton");

        const deleteButton =
            document.getElementById("deleteButton");



        function updateToolbar()
        {
            const selectedCount =
                document.querySelectorAll(
                    ".user-checkbox:checked"
                ).length;

            const disabled = selectedCount === 0;

            blockButton.disabled = disabled;
            unblockButton.disabled = disabled;
            deleteButton.disabled = disabled;
        }

        selectAll.addEventListener("change", function ()
        {
            checkboxes.forEach(checkbox =>
            {
                checkbox.checked = selectAll.checked;
            });

            updateToolbar();
        });
                checkboxes.forEach(checkbox =>
        {
            checkbox.addEventListener("change", function ()
            {
                const allChecked =
                    Array.from(checkboxes)
                        .every(x => x.checked);

                selectAll.checked = allChecked;

                updateToolbar();
            });
        });

        document
            .querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(element =>
            {
                new bootstrap.Tooltip(element);
            });
    </script>
}

<form method="post">

    <div class="card border-0 shadow-sm">

    <div class="card-header bg-white p-0">

    <!-- Toolbar -->
    <div class="d-flex align-items-center gap-2 border-bottom bg-white p-3">

        <!-- Required: Block with text -->
        <button type="submit"
                id="blockButton"
                asp-controller="Home"
                asp-action="Block"
                class="btn btn-outline-danger cursor-pointer"
                disabled>
            Block
        </button>

        <!-- Unblock -->
        <button type="submit"
                id="unblockButton"
                asp-controller="Home"
                asp-action="Unblock"
                class="btn btn-outline-secondary cursor-pointer"
                data-bs-toggle="tooltip"
                title="Unblock selected users"
                disabled>

            <i class="bi bi-unlock"></i>
        </button>

        <!-- Delete -->
        <button type="submit"
                id="deleteButton"
                asp-controller="Home"
                asp-action="Delete"
                class="btn btn-outline-danger cursor-pointer"
                data-bs-toggle="tooltip"
                title="Delete selected users"
                disabled>

            <i class="bi bi-trash"></i>
        </button>

        <!-- Delete Unverified -->
        <button type="submit"
                asp-controller="Home"
                asp-action="DeleteUnverified"
                class="btn btn-outline-danger cursor-pointer"
                data-bs-toggle="tooltip"
                title="Delete unverified users">

            <i class="bi bi-person-x"></i>
        </button>

    </div>

    </div>

    <div class="card-body p-0">

        <!-- table here -->

    <!-- Table -->
    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>

                    <th style="width: 50px;">
                        <input type="checkbox"
                               id="selectAll"
                               class="form-check-input" />
                    </th>

                    <th>Name</th>
                    <th>Email</th>
                    <th>Last login</th>
                    <th>Status</th>

                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>
                            <input type="checkbox"
                                   name="selectedIds"
                                   value="@user.Id"
                                   class="form-check-input user-checkbox" />
                        </td>

                        <td class="fw-semibold">
                            @user.Name
                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>
                            @if (user.LastLoginAt.HasValue)
                            {
                                @user.LastLoginAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Never
                                </span>
                            }
                        </td>

                        <td>
                            @user.Status
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
    </div>


</form>