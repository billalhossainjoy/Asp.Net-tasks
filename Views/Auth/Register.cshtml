@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">

        <!-- Sign Up Form -->
        <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center py-5">

            <div class="w-100 px-3 px-sm-4 px-md-5" style="max-width: 520px;">

                <!-- Logo -->
                <div class="mb-4 mb-md-5">
                    <h2 class="fw-bold text-primary mb-0">
                        My App
                    </h2>
                </div>

                <!-- Heading -->
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-2">
                        Create your account
                    </h1>

                    <p class="text-secondary mb-0">
                        Join us and start your journey today.
                    </p>
                </div>

                <!-- Form -->
                <form asp-action="Register" asp-controller="Auth" method="post">

                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                    </div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Full name
                        </label>

                        <input asp-for="Name" class="form-control form-control-lg">
                        <span asp-validation-for="Name" class="text-danger mb-3"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            Email address
                        </label>

                        <input asp-for="Email" class="form-control form-control-lg">
                        <span asp-validation-for="Email" class="text-danger mb-3"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Password
                        </label>

                        <input asp-for="Password" class="form-control form-control-lg"
                        >
                        <span asp-validation-for="Password" class="text-danger mb-3"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label fw-semibold">
                            Confirm password
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control form-control-lg">

                        <span asp-validation-for="ConfirmPassword" class="text-danger mb-3"></span>
                    </div>

                    <!-- Terms -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Terms">

                        <label class="form-check-label" asp-for="Terms">

                            I agree to the

                            <a href="/Terms" class="text-decoration-none">
                                Terms & Conditions
                            </a>

                            and

                            <a href="/Privacy" class="text-decoration-none">
                                Privacy Policy
                            </a>
                        </label>
                    </div>

                    <!-- Sign Up Button -->
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Create Account
                    </button>

                </form>

                <!-- Login Link -->
                <div class="text-center mt-4">
                    <p class="text-secondary mb-0">
                        Already have an account?

                        <a href="/auth/login" class="text-decoration-none fw-semibold">
                            Sign in
                        </a>
                    </p>
                </div>

            </div>
        </div>

        <!-- Image Section -->
        <div class="col-lg-6 d-none d-lg-flex
            align-items-center justify-content-center
            p-4 p-xl-5">

            <img src="/register.png" alt="Sign up" class="img-fluid" style="
            max-width: 90%;
            max-height: 85vh;
            object-fit: contain;
            ">
        </div>

    </div>
</div>