<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">

        <!-- Login Form -->
        <div
            class="col-12 col-lg-6 d-flex align-items-center justify-content-center py-5">

            <div class="w-100 px-3 px-sm-4 px-md-5" style="max-width: 520px;">

                <!-- Logo -->
                <div class="mb-4 mb-md-5">
                    <h2 class="fw-bold text-primary mb-0">
                        My App
                    </h2>
                </div>

                <!-- Heading -->
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-2">
                        Sign in to My App
                    </h1>

                    <p class="text-secondary mb-0">
                        Start your journey with us.
                    </p>
                </div>

                <!-- Form -->
                <form>

                    <!-- Email -->
                    <div class="mb-3">
                        <label
                            for="email"
                            class="form-label fw-semibold">
                            Email address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control form-control-lg"
                            placeholder="name@example.com"
                            autocomplete="email"
                            required>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label
                            for="password"
                            class="form-label fw-semibold">
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control form-control-lg"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required>
                    </div>

                    <!-- Remember + Forgot -->
                    <div
                        class="d-flex flex-column flex-sm-row
                               justify-content-sm-between
                               align-items-sm-center
                               gap-2 mb-4">

                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="remember">

                            <label
                                class="form-check-label"
                                for="remember">
                                Remember me
                            </label>
                        </div>

                        <a
                            href="/Auth/ForgotPassword"
                            class="text-decoration-none">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Sign In -->
                    <button
                        type="submit"
                        class="btn btn-primary btn-lg w-100">
                        Sign In
                    </button>

                </form>

                <!-- Sign Up -->
                <div class="text-center mt-4">
                    <p class="text-secondary mb-0">
                        Don't have an account?

                        <a
                            href="/auth/register"
                            class="text-decoration-none fw-semibold">
                            Sign up
                        </a>
                    </p>
                </div>

            </div>
        </div>

        <!-- Image Section -->
        <div
            class="col-lg-6 d-none d-lg-flex
                   align-items-center justify-content-center
                   p-4 p-xl-5">

            <img
                src="/login.png"
                alt="Login"
                class="img-fluid"
                style="max-width: 90%; max-height: 85vh; object-fit: contain;">
        </div>

    </div>
</div>